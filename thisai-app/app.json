{
  "expo": {
    "name": "thisai-app",
    "slug": "thisai-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "thisaiapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.dharshinibabu.thisai",
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow THISAI to convert your speech into editable text.",
        "NSMicrophoneUsageDescription": "Allow THISAI to access your microphone so you can speak your personal story."
      }
    },
    "android": {
      "package": "com.dharshinibabu.thisai",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow THISAI to access your microphone so you can speak your personal story.",
          "speechRecognitionPermission": "Allow THISAI to convert your speech into editable text.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "c8d27d81-0fac-450b-9f3d-0eab397fc3a7"
      }
    }
  }
}
